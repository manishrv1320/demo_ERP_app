# Hyperzen ERP — environment variables.
#
# Local development: copy this file to `.env` (git-ignored). `npm run setup:env`
# does that for you and fills in a fresh DATA_ENCRYPTION_KEY without printing it.
# Production: the server's /home/dev2/hzerp-data/app.env (mode 600), generated
# on the server. Never commit real values.

# --- Database ---------------------------------------------------------------
# Local: the embedded PGlite started by `npm run db:dev`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5443/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# Only `prisma migrate dev` uses this (a throwaway database to check migrations).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5444/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# --- Site ---------------------------------------------------------------------
# The public address. https:// turns on the canonical redirect and HSTS.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Encryption at rest -----------------------------------------------------------
# 32 random bytes, base64. Encrypts private files and stored SMTP passwords.
# Losing it loses those files. Keep a copy somewhere OTHER than the backups.
DATA_ENCRYPTION_KEY=""

# --- Private file storage --------------------------------------------------------
# Outside the repo. Local default: ../.hyperzen-erp-storage
# FILE_STORAGE_ROOT="/srv/hzerp-storage"

# --- SMS (optional, off by default) -----------------------------------------------
# Password-reset codes by text. Leave unset to use email only.
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
